{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[lang]/layout,_N_T_/[lang]/services/layout,_N_T_/[lang]/services/[slug]/layout,_N_T_/[lang]/services/[slug]/page,_N_T_/ar/services/hotel-booking"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$lang",
    "/$d$lang/services/$d$slug/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 64,
    "slots": {
      "children": {
        "hints": 32,
        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 96,
                "slots": {
                  "children": {
                    "hints": 160,
                    "slots": null
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}